<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Generate Hashtags | LinkedInk</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/output.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Sora:wght@100..800&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
    rel="stylesheet" />
  <link rel="shortcut icon" href="./assets/logo.svg" type="image/x-icon">
</head>

<body class="bg-[#07050c] text-[#e3dfec] font-inter flex flex-col min-h-screen">
  <%- include('navbar') %>

    <main class="min-h-screen pt-24 pb-12 flex flex-col items-center justify-center px-6 md:px-12 lg:px-24">
      <h1 class="text-3xl font-bold mb-6 text-center">
        Generate <span class="gradient-text">LinkedIn</span> Hashtags
      </h1>

      <form action="/generate-hashtags" method="POST"
        class="max-w-3xl w-full mx-auto p-6 rounded-lg border border-[#e3dfec] shadow-[0_0_40px_#4a22a8aa] transition-all duration-300">
        <label for="topic" class="block mb-2 text-sm font-medium">
          Enter the topic or keywords of your LinkedIn post
        </label>
        <textarea id="topic" name="topic" rows="5"
          class="block w-full p-3 text-lg text-[#e3dfec] rounded-lg border placeholder-gray-400 focus:ring-[#e3dfec] border-[#e3dfec] transition duration-300"
          placeholder="E.g. Web development, leadership, ReactJS, career advice..."></textarea>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div>
            <label for="industry" class="block mb-2 text-sm font-medium">Industry</label>
            <select id="industry" name="industry"
              class="block w-full p-3 text-lg text-[#e3dfec] bg-[#07050c] rounded-lg border focus:ring-[#e3dfec] border-[#e3dfec] transition duration-300">
              <option value="Technology">Technology</option>
              <option value="Marketing/Sales">Marketing/Sales</option>
              <option value="Finance">Finance</option>
              <option value="Healthcare">Healthcare</option>
              <option value="General Business">General Business</option>
              <option value="Freelance/Creator">Freelance/Creator</option>
            </select>
          </div>
          <div>
            <label for="audience" class="block mb-2 text-sm font-medium">Target Audience</label>
            <select id="audience" name="audience"
              class="block w-full p-3 text-lg text-[#e3dfec] bg-[#07050c] rounded-lg border focus:ring-[#e3dfec] border-[#e3dfec] transition duration-300">
              <option value="General Audience">General Audience</option>
              <option value="Recruiters/Hiring Managers">Recruiters/Hiring Managers</option>
              <option value="Peers/Industry Professionals">Peers/Industry Professionals</option>
              <option value="Potential Clients">Potential Clients</option>
            </select>
          </div>
        </div>

        <button type="submit"
          class="mt-6 w-full cursor-pointer bg-gradient-to-r from-[#6e50b9] to-[#4a22a8] hover:from-[#2d1363] hover:to-[#1c0b45] text-[#e3dfec] font-semibold py-2 px-4 rounded-lg transition duration-300 genButton"
          onclick="generating()">
          Generate Hashtags
        </button>
      </form>
    </main>

    <%- include('footer') %>

      <script>
        function generating() {
          const genBtn = document.querySelector(".genButton");
          genBtn.innerText = "Generating...";
        }
      </script>
      <script src="https://unpkg.com/flowbite@1.6.5/dist/flowbite.min.js"></script>
</body>

</html>
